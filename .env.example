# ═══════════════════════════════════════════
# 📱 BOT SOZLAMALARI
# ═══════════════════════════════════════════
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# ═══════════════════════════════════════════
# 🗄 DATABASE (PostgreSQL)
# ═══════════════════════════════════════════
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signal_bot_v2
DB_USER=postgres
DB_PASSWORD=your_strong_password_here

# ═══════════════════════════════════════════
# 🔴 REDIS
# ═══════════════════════════════════════════
REDIS_HOST=localhost
REDIS_PORT=6379

# ═══════════════════════════════════════════
# 📈 SIGNAL KANAL (PRIVATE)
# ═══════════════════════════════════════════
PRIVATE_CHANNEL_ID=-100xxxxxxxxxx
FREE_CHANNEL_LINK=https://t.me/your_free_channel

# ═══════════════════════════════════════════
# 💳 KARTA TO'LOV
# ═══════════════════════════════════════════
CARD_NUMBER=8600-xxxx-xxxx-xxxx
CARD_HOLDER=FALONCHAYEV FALONCHA

# ═══════════════════════════════════════════
# 🔗 KRIPTO AVTOMATIK TO'LOV (TRON TRC20 / BNB BEP20)
# ═══════════════════════════════════════════
# Bot blokcheyndagi tranzaksiyalarni o'zi tekshiradi va to'lovni avtomatik qabul qiladi
TON_WALLET_ADDRESS=TRxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BNB_WALLET_ADDRESS=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRYPTO_AUTO_ENABLED=true
CRYPTO_POLL_SECONDS=60
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
BNB_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_RPC_URL=https://bsc-dataseed.binance.org
TRONGRID_API_KEY=

# Crypto Pay app token. Use the same app and network on bot and website services.
PROJECT_CRYPTO_PAY_TOKEN=
PROJECT_CRYPTO_PAY_TESTNET=false

# ═══════════════════════════════════════════
# 👮 ADMIN
# ═══════════════════════════════════════════
ADMIN_IDS=[123456789]
ADMIN_LINK=@your_admin_username

# ═══════════════════════════════════════════
# 🌐 IJTIMOIY TARMOQLAR
# ═══════════════════════════════════════════
SOCIAL_INSTAGRAM=https://instagram.com/example
SOCIAL_TWITTER=https://twitter.com/example
SOCIAL_YOUTUBE=https://youtube.com/@example
SOCIAL_WEBSITE=https://example.com
